# list recipes
default:
    @just --list

# apply formatting and safe lint fixes
format:
    uv run ruff format .
    uv run ruff check --fix .

# format check, lint, type check
lint:
    uv run --locked ruff format --check .
    uv run --locked ruff check .
    uv run --locked ty check

# run tests
test:
    uv run --locked pytest

# what CI runs
check: lint test

# upgrade locked dependencies
upgrade:
    uv lock --upgrade
    uv sync

image_name := env("IMAGE", "ghcr.io/edepree/isc-unifi-connector")

# build the image tagged with the project version and latest
image:
    docker build -t {{ image_name }}:$(uv version --short) -t {{ image_name }}:latest .
